# Trino — variaveis de ambiente (sem secrets reais)
# Copie para .env.trino e preencha. Nunca commitar .env.trino.

TRINO_HOST=trino.example.univesp.br
TRINO_PORT=443
TRINO_USER=crm-import
TRINO_PASSWORD=
TRINO_HTTP_SCHEME=https
TRINO_CATALOG=postgresql-sei
TRINO_SCHEMA=public

# Site Frappe alvo para --apply
FRAPPE_SITE_NAME=homolog-crm.univesp.br

# Situacoes SEI importadas para alunos (CSV)
STUDENT_SITUACOES=AT
