    {"fieldname": "email", "fieldtype": "Data", "label": "Email SSO", "options": "Email", "reqd": 1, "in_list_view": 1},
    {"fieldname": "nome", "fieldtype": "Data", "label": "Nome", "reqd": 1, "in_list_view": 1},
