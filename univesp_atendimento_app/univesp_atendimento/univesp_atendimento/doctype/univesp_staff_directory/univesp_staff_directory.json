    {"fieldname": "polo_nome", "fieldtype": "Data", "label": "Polo", "in_list_view": 1},
    {"fieldname": "pessoa_codigo", "fieldtype": "Data", "label": "Codigo pessoa SEI", "read_only": 1},
    {"fieldname": "cargo_ativo", "fieldtype": "Check", "label": "Cargo ativo", "default": "1", "in_list_view": 1},
    {"fieldname": "import_section", "fieldtype": "Section Break", "label": "Importacao"},
