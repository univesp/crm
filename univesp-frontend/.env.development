VITE_APP_NAME=UNIVESP Atendimento
VITE_APP_BASE=/crm/
VITE_ROUTER_BASE=/crm/
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=8080
VITE_PREVIEW_HOST=0.0.0.0
VITE_PREVIEW_PORT=8080
VITE_ASSETS_DIR=univesp-assets

VITE_ENABLE_MOCKS=false
VITE_ENABLE_ANALYTICS_MOCKS=false

# ── Frappe CRM API (dados: leads, tickets, etc.) ──────────────────────────
# A integracao com o Frappe eh somente via API Key (token), sem SSO.
VITE_FRAPPE_BASE_URL=
VITE_FRAPPE_API_PREFIX=/api
VITE_FRAPPE_AUTH_MODE=token
VITE_FRAPPE_TOKEN_STORAGE_KEY=univesp.frappe.authHeader
VITE_FRAPPE_AUTH_HEADER=
# Gere a API Key no Frappe: Setup > Users > [usuario] > API Access > Generate keys
VITE_FRAPPE_API_KEY=4aad9a6212bdc85
VITE_FRAPPE_API_SECRET=e5ba6241b45fa27
VITE_FRAPPE_PROXY_TARGET=http://localhost:8000
VITE_FRAPPE_SOCKETIO_TARGET=http://localhost:9000
VITE_FRAPPE_TICKET_DOCTYPE=Issue

# ── Azure AD SSO (autenticacao do usuario, client-side) ───────────────────
# Registre um App no Azure Portal > App registrations
# Redirect URI: http://localhost:8080/crm/login
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:8080/crm/login

# ── SSO dev bypass (para desenvolvimento sem Azure) ──────────────────────
VITE_DEFAULT_AUTH_ROUTE=/
VITE_SSO_DEV_BYPASS=true
VITE_SSO_DEV_BYPASS_EMAIL=admin@univesp.br
VITE_SSO_DEV_BYPASS_NAME=Administrador Local

# ── IA / Integracao ──────────────────────────────────────────────────────
VITE_AI_GATEWAY_URL=https://ai-gateway.example.com
VITE_AI_NAMESPACE=univesp-atendimento

# ── SAML blueprint (referencia — nao usado em runtime) ───────────────────
VITE_SAML_ENTITY_ID=crm_development
VITE_SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:email
VITE_SAML_NAME_ID_ATTRIBUTE=mail
VITE_SAML_ACS_URL=http://localhost:8080/consume
VITE_SAML_LOGOUT_URL=http://localhost:8080/logout
VITE_SAML_IDP_METADATA_URL=https://login.univesp.br/simplesaml/saml2/idp/metadata.php
VITE_HANDOFF_WEBHOOK_URL=https://contact-center.example.com/handoff
