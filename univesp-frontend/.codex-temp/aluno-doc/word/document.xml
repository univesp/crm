fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="382A3817" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Quero reiniciar esta tarefa com uma restrição mais rígida de processo e aderência visual.</w:t></w:r></w:p><w:p w14:paraId="46B68FAA" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="64B24745" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>IMPORTANTE:</w:t></w:r></w:p><w:p w14:paraId="26650C18" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- Siga rigorosamente o `AGENTS.md` antes de qualquer ação.</w:t></w:r></w:p><w:p w14:paraId="0D8DA906" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t xml:space="preserve">- Antes de </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>codar</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve">, você DEVE criar um </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>wireframe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> fiel à referência aprovada.</w:t></w:r></w:p><w:p w14:paraId="0E99F66B" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- Nesta rodada, NÃO quero implementação inicial.</w:t></w:r></w:p><w:p w14:paraId="438F12EE" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- Primeiro quero validação de UX, estrutura visual e aderência ao modelo.</w:t></w:r></w:p><w:p w14:paraId="62D606CE" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t xml:space="preserve">- Só depois de eu aprovar o </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>wireframe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> você poderá implementar.</w:t></w:r></w:p><w:p w14:paraId="47CFFE94" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="11664345" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>## Problema da rodada anterior</w:t></w:r></w:p><w:p w14:paraId="1B2F56D4" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>A proposta implementada não seguiu suficientemente o modelo visual e estrutural que foi aprovado.</w:t></w:r></w:p><w:p w14:paraId="0222D5AA" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Ela interpretou a ideia, mas desviou da referência.</w:t></w:r></w:p><w:p w14:paraId="0D6B9BA6" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Os principais problemas foram:</w:t></w:r></w:p><w:p w14:paraId="743EEE52" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- home com cara de portal/painel, e não de jornada guiada;</w:t></w:r></w:p><w:p w14:paraId="2D49A76B" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- tela “Tenho uma dúvida” aberta demais, com pouco senso de fluxo;</w:t></w:r></w:p><w:p w14:paraId="7DA86F70" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- desktop com blocos paralelos demais;</w:t></w:r></w:p><w:p w14:paraId="41C80509" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- mobile sem sensação clara de fluxo mobile-first;</w:t></w:r></w:p><w:p w14:paraId="31761318" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>- aderência insuficiente às imagens de referência.</w:t></w:r></w:p><w:p w14:paraId="19C75DFB" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="106D2CFE" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>## Objetivo desta rodada</w:t></w:r></w:p><w:p w14:paraId="4763D8B3" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Quero que você redesenhe a jornada do aluno com aderência muito maior às imagens-guia aprovadas.</w:t></w:r></w:p><w:p w14:paraId="5C7D2F5B" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="498E9837" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>## Regra principal</w:t></w:r></w:p><w:p w14:paraId="7E724DDE" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Não quero uma interpretação livre do layout.</w:t></w:r></w:p><w:p w14:paraId="02224054" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t xml:space="preserve">Quero um </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:t>wireframe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:t xml:space="preserve"> estrutural fiel à direção aprovada.</w:t></w:r></w:p><w:p w14:paraId="770A8199" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="691AB56E" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Se você entender que algum ponto da referência precisa de ajuste por UX real, você deve:</w:t></w:r></w:p><w:p w14:paraId="40AF2EA1" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>1. manter a referência como base;</w:t></w:r></w:p><w:p w14:paraId="1B9C9F05" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>2. apontar claramente a divergência;</w:t></w:r></w:p><w:p w14:paraId="628D560F" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>3. justificar antes de implementar.</w:t></w:r></w:p><w:p w14:paraId="632B7615" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"/><w:p w14:paraId="155DEE68" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>## Referências aprovadas</w:t></w:r></w:p><w:p w14:paraId="4F8FB90A" w14:textId="7DD1C241" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:t>Use as imagens abaixo como modelo principal de estrutura, hierarquia e composição.</w:t></w:r><w:r><w:br/></w:r><w:r><w:br/><w:t>visualização no mobile</w:t></w:r></w:p><w:p w14:paraId="6280BFA1" w14:textId="77777777" w:rsidR="00417863" w:rsidRDefault="00417863" w:rsidP="00417863"><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="00927037" wp14:editId="736AE84B"><wp:extent cx="5784850" cy="5760696"/><wp:effectExtent l="0" t="0" r="6350" b="0"/><wp:docPr id="942825895" name="Imagem 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 1"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowh