{
  "name": "univesp-frontend-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "preview": "vite preview",
    "preview:local": "vite preview --host 0.0.0.0 --port 8080",
    "review": "vite build --mode development && npm run preview:local",
    "lint": "eslint . --ext .js,.vue --max-warnings=0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:foundation": "node scripts/run-canonical-tests.mjs"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "globals": "^15.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^5.4.18",
    "vue-tsc": "^2.0.0"
  }
}
