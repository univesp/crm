# Copie para .env.vm na raiz do worktree. Nunca commite .env.vm com secrets reais.

# --- Publico / dominio ---
APP_BASE_URL=https://homolog-crm.univesp.br
VM_HTTP_PORT=8080
COOKIE_DOMAIN=
TRUST_PROXY_HOPS=1

# --- Frappe (bench na VM ou host) ---
FRAPPE_ORIGIN=http://host.docker.internal:8000
FRAPPE_SOCKETIO_ORIGIN=http://host.docker.internal:9000
FRAPPE_SITE_NAME=homolog-crm.univesp.br
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- Segredos BFF ↔ Frappe ---
UNIVESP_BFF_SHARED_SECRET=
UNIVESP_EDGE_SHARED_SECRET=
UNIVESP_INGRESS_SHARED_SECRET=
SESSION_SECRET=
JWT_SECRET=

# --- Redis (compose local) ---
GATEWAY_REDIS_URL=redis://redis:6379

# --- Knowledge Studio (curadoria FAQ) ---
KNOWLEDGE_STUDIO_PORT=8090
KNOWLEDGE_STUDIO_PIN=

VITE_SSO_DEV_BYPASS=false
VITE_ENABLE_MOCKS=false

# --- Azure AD homolog ---
AZURE_ADMIN_CLIENT_ID=1af85e0d-b7d8-4bac-aa25-bc8e7bd673d6
AZURE_ADMIN_TENANT_ID=99106079-5014-41d9-a528-f4a73e8b2d1e
AZURE_ADMIN_CLIENT_SECRET=
AZURE_ACADEMICO_CLIENT_ID=d533ec8a-d1ed-4e83-8c75-f6cd67de4013
AZURE_ACADEMICO_TENANT_ID=99106079-5014-41d9-a528-f4a73e8b2d1e
AZURE_ACADEMICO_CLIENT_SECRET=
AZURE_REDIRECT_URI=https://homolog-crm.univesp.br/api/sso/azure/callback

# --- SAML aluno ---
SAML_IDP_SSO_URL=https://login.univesp.br/simplesaml/saml2/idp/SSOService.php
SAML_IDP_CERT=
SAML_ACS_URL=https://homolog-crm.univesp.br/api/sso/saml/callback
SAML_ENTITY_ID=https://homolog-crm.univesp.br/saml/sp

# --- GCS anexos (Fase A0b) ---
GCS_PROJECT=univesp-201808
GCS_BUCKET=univesp-crm-attachments-homolog
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-sa.json

# --- Import Trino (Trilha D) ---
TRINO_HOST=
TRINO_PORT=443
TRINO_USER=
TRINO_PASSWORD=
TRINO_CATALOG=postgresql-sei
TRINO_SCHEMA=public
